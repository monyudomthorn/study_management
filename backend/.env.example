APP_NAME="Study Management API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Configuration (Set by Railway / Render / Host)
DB_CONNECTION=mysql
